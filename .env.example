# Copy to .env and fill in. .env is git-ignored: never commit real values.

# --- Azure: the crypto-pipeline service principal (from `az ad sp create-for-rbac`) ---
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change-me

# --- Azure resources (storage account and workspace names must be globally unique) ---
AZURE_RESOURCE_GROUP=rg-crypto-stream
AZURE_LOCATION=southafricanorth
AZURE_STORAGE_ACCOUNT=cryptolakeyourname
AZURE_CONTAINER=lake

# --- Synapse serverless SQL ---
SYNAPSE_WORKSPACE=crypto-synapse-yourname
SYNAPSE_SQL_ENDPOINT=crypto-synapse-yourname-ondemand.sql.azuresynapse.net
SYNAPSE_DATABASE=cryptodw
SYNAPSE_SQL_USER=sqladminuser
SYNAPSE_SQL_PASSWORD=Change-Me-123!

# --- Streaming ---
KAFKA_TOPIC=crypto_trades
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,dogeusdt,adausdt,avaxusdt
BINANCE_WS_BASE=wss://data-stream.binance.vision
